<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="TransitOPS_net.AdminMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Admin - TransitOps</asp:ContentPlaceHolder></title>
    <link href="~/Content/site.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="layout-shell">
            <aside class="sidebar" id="sidebar">
                <div class="sidebar-header">
                    <div class="sidebar-logo">
                        <div class="logo-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1b4332" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z" /><path d="M16 8h4l3 3v5h-7V8z" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                        </div>
                        <div class="logo-text">
                            <h1>TransitOps</h1>
                            <p>Fleet Management</p>
                        </div>
                    </div>
                </div>

                <div class="sidebar-section" style="padding-top:0.5rem">
                    <a href="../Guest/Home.aspx" class="menu-item" title="Back to home page" style="opacity:0.7">
                        <span class="menu-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span>
                        <span class="menu-label">Back to Home</span>
                    </a>
                </div>

                <div class="sidebar-section">
                    <h3 class="section-title">Main Menu</h3>
                    <nav class="sidebar-menu">
                        <a href="../Admin/Dashboard.aspx" class="menu-item" data-page="dashboard" title="Dashboard"><span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span><span class="menu-label">Dashboard</span></a>
                        <a href="../FleetManager/Vehicles.aspx" class="menu-item" data-page="vehicles" title="Vehicles"><span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span><span class="menu-label">Vehicles</span></a>
                        <a href="../SafetyOfficer/Drivers.aspx" class="menu-item" data-page="drivers" title="Drivers"><span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span class="menu-label">Drivers</span></a>
                        <a href="../Dispatcher/Trips.aspx" class="menu-item" data-page="trips" title="Trips"><span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg></span><span class="menu-label">Trips</span></a>
                        <a href="../FinancialAnalyst/FuelExpenses.aspx" class="menu-item" data-page="expenses" title="Expenses"><span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span><span class="menu-label">Expenses</span></a>
                        <a href="../FleetManager/Maintenance.aspx" class="menu-item" data-page="maintenance" title="Maintenance"><span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></span><span class="menu-label">Maintenance</span></a>
                        <a href="../Admin/Reports.aspx" class="menu-item" data-page="reports" title="Reports"><span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></span><span class="menu-label">Reports</span></a>
                        <a href="../Admin/Analytics.aspx" class="menu-item" data-page="analytics" title="Analytics"><span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg></span><span class="menu-label">Analytics</span></a>
                    </nav>
                </div>

                <div class="sidebar-section">
                    <h3 class="section-title">Settings</h3>
                    <div class="sidebar-footer-menu">
                        <a href="../Admin/Settings.aspx" class="menu-item" data-page="settings" title="Settings"><span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span><span class="menu-label">Settings</span></a>
                        <a href="../Guest/SignIn.aspx" class="menu-item logout" title="Logout"><span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span><span class="menu-label">Logout</span></a>
                    </div>
                </div>
            </aside>

            <div class="layout-content" id="layoutContent">
                <header class="navbar">
                    <div class="navbar-left">
                        <button type="button" class="sidebar-toggle-button" onclick="document.querySelector('.sidebar').classList.toggle('collapsed');document.getElementById('layoutContent').classList.toggle('sidebar-collapsed');return false;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                        </button>
                        <div class="search-bar">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" placeholder="Search vehicles, drivers, trips.." />
                        </div>
                    </div>
                    <div class="navbar-right">
                        <span class="notification-wrapper">
                            <button type="button" class="navbar-button">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                <span class="notification-badge">3</span>
                            </button>
                        </span>
                        <span class="navbar-divider"></span>
                        <span class="user-menu">
                            <button type="button" class="user-profile">
                                &nbsp;<span class="user-name">Divya Javiyaa</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </button>
                        </span>
                    </div>
                </header>
                <div class="main-content">
                    <div class="content-wrapper">
                        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </div>
            </div>
        </div>
        <script src='<%= ResolveUrl("~/Scripts/app.js") %>'></script>
        <script>
            (function () {
                var path = window.location.pathname.toLowerCase();
                var map = { 'dashboard': 'dashboard', 'vehicles': 'vehicles', 'drivers': 'drivers', 'trips': 'trips', 'fuelexpenses': 'expenses', 'expenses': 'expenses', 'maintenance': 'maintenance', 'reports': 'reports', 'analytics': 'analytics', 'settings': 'settings' };
                document.querySelectorAll('.sidebar-menu .menu-item[data-page]').forEach(function (a) {
                    var key = a.getAttribute('data-page');
                    for (var k in map) { if (path.indexOf(k) !== -1 && map[k] === key) { a.classList.add('active'); } }
                });
            })();
        </script>
    </form>
</body>
</html>
