<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="TransitOPS_net.AdminMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Admin - TransitOps</asp:ContentPlaceHolder></title>
    <link href="~/Content/site.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="admin-layout">
            <aside class="admin-sidebar" id="sidebar" runat="server">
                <div class="admin-brand">
                    <a href="~/Admin/Dashboard.aspx" class="to-brand">
                        <span class="to-brand-mark">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 3h15v13H1z" /><path d="M16 8h4l3 3v5h-7V8z" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" />
                            </svg>
                        </span>
                        TransitOps Admin
                    </a>
                </div>
                <nav class="admin-nav">
                    <ul>
                        <li><a href="~/Admin/Dashboard.aspx" runat="server" id="lnkDashboard"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span>Dashboard</span></a></li>
                        <li><a href="~/FleetManager/Vehicles.aspx" runat="server" id="lnkVehicles"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 9h15v13H1z"/><path d="M16 9h4l3-3v-3"/><circle cx="5.5" cy="17.5" r="2.5"/><circle cx="18.5" cy="17.5" r="2.5"/></svg><span>Vehicle Registry</span></a></li>
                        <li><a href="~/Dispatcher/Trips.aspx" runat="server" id="lnkTrips"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg><span>Trips</span></a></li>
                        <li><a href="~/SafetyOfficer/Drivers.aspx" runat="server" id="lnkDrivers"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Drivers</span></a></li>
                        <li><a href="~/FinancialAnalyst/FuelExpenses.aspx" runat="server" id="lnkExpenses"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><span>Expenses</span></a></li>
                    </ul>
                </nav>
                <div class="admin-user">
                    <span class="admin-user-name">Divya (Admin)</span>
                    <a href="~/Guest/SignIn.aspx" class="admin-signout">Sign Out</a>
                </div>
            </aside>
            <div class="admin-main">
                <header class="admin-topbar">
                    <button class="admin-menu-toggle" id="menuToggle" onclick="toggleSidebar()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>
                    <div class="admin-search">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" placeholder="Search vehicles, trips, drivers..." />
                    </div>
                    <div class="admin-topbar-right">
                        <button class="admin-notify"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></button>
                        <div class="admin-avatar">D</div>
                    </div>
                </header>
                <main class="admin-content">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
        <script src='<%= ResolveUrl("~/Scripts/app.js") %>'></script>
        <script>
            function toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('collapsed');
                document.querySelector('.admin-main').classList.toggle('expanded');
            }
        </script>
    </form>
</body>
</html>